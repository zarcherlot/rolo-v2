{
  "schema_version": "rolo-episode-observation-bundle-contract-design/v1",
  "status": "e22b-producer-review-candidate",
  "base_feature": "workbench.episode-read-model/v1",
  "candidate_feature": "workbench.episode-observation-bundle/v1",
  "contracts": {
    "collection": "rolo-episode-observation-bundle-collection/v1",
    "summary": "rolo-episode-observation-bundle-summary/v1",
    "source_coverage": "rolo-episode-observation-source-coverage/v1",
    "asset_reference": "rolo-episode-asset-summary/v1",
    "evidence_reference": "rolo-evidence-record/v1"
  },
  "endpoint": "GET /v1/robots/{robot_id}/episodes/{episode_id}/observation-bundles?revision={revision}&limit={limit}&cursor={cursor}",
  "revision_policy": "EXACT_IMMUTABLE_EPISODE_REVISION",
  "ordering_policy": "NEWEST_FIRST_STRICT_SEQUENCE_DESCENDING",
  "page_limit": {
    "minimum": 1,
    "maximum": 20
  },
  "trigger_kinds": ["INITIAL", "SUPPLEMENTARY"],
  "bundle_statuses": ["COMPLETE", "PARTIAL", "UNAVAILABLE"],
  "source_kinds": [
    "ONBOARD_SENSOR",
    "EXTERNAL_MEASUREMENT",
    "ROBOT_STATE",
    "SPATIAL_MODEL",
    "DETERMINISTIC_RENDER",
    "TRUSTED_GUI_CAPTURE",
    "SIMULATION"
  ],
  "source_availability": ["AVAILABLE", "MISSING", "STALE", "REJECTED", "UNAVAILABLE"],
  "synchronization_states": ["SYNCED", "DEGRADED", "UNSYNCED", "UNKNOWN"],
  "spatial_alignment_states": ["ALIGNED", "DEGRADED", "UNALIGNED", "UNKNOWN"],
  "world_kinds": ["PHYSICAL", "SIMULATED", "REPLAYED"],
  "world_scopes": ["NONE", "PHYSICAL_ONLY", "SIMULATED_ONLY", "REPLAYED_ONLY", "MIXED"],
  "bundle_public_fields": [
    "robot_id",
    "episode_id",
    "episode_revision",
    "bundle_id",
    "sequence",
    "parent_bundle_id",
    "trigger_kind",
    "status",
    "created_at",
    "window_start_offset_ms",
    "window_end_offset_ms",
    "synchronization",
    "spatial_alignment",
    "world_scope",
    "sources",
    "asset_ids",
    "evidence_ids",
    "limitations",
    "influences_verification"
  ],
  "required_invariants": [
    "all pages and references are pinned to one robot episode and immutable episode revision",
    "bundle pages are newest first and optional parents have lower sequence in the same episode revision",
    "a complete traversal resolves every parent and rejects cycles or dangling parents",
    "every asset id resolves to an existing public episode asset in the same revision",
    "source assets are a subset of the bundle asset ids",
    "time synchronization and spatial alignment remain independent",
    "world scope is derived from asset bearing source world kinds and no assets means none",
    "missing rejected and unavailable sources have no asset references",
    "complete bundle status never upgrades execution outcome finding authority or verification",
    "influences_verification is always false"
  ],
  "forbidden_fields": [
    "artifact_ref",
    "artifact_path",
    "local_path",
    "remote_path",
    "uri",
    "signed_url",
    "hostname",
    "device_path",
    "topic_name",
    "source_identity",
    "provider_identity",
    "credential",
    "storage_location",
    "command_payload",
    "telemetry_payload",
    "state_payload",
    "tf_payload",
    "point_cloud_payload",
    "map_payload",
    "calibration_payload",
    "renderer_config",
    "model_prompt",
    "model_response",
    "content_url",
    "content_key"
  ],
  "implementation": {
    "producer": "candidate-e22b",
    "endpoint": "candidate-e22b",
    "feature_advertisement": "candidate-e22b",
    "consumer": "deferred-e22c",
    "media_delivery": false,
    "supports_capture": false,
    "supports_recollection": false,
    "supports_replay": false,
    "supports_export": false,
    "supports_write": false
  }
}
