{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rolo.local/schemas/ReleaseChunkUpload.schema.json",
  "title": "Content-addressed Release Chunk Upload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "blob_digest", "total_bytes", "chunk_size", "chunk_digests", "media_type"],
  "properties": {
    "schema_version": {"const": "rolo-release-chunk-upload/v1"},
    "blob_digest": {"$ref": "#/$defs/digest"},
    "total_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
    "chunk_size": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "chunk_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/digest"}
    },
    "media_type": {"type": "string", "minLength": 1, "maxLength": 128}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
