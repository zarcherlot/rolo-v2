{
  "$id": "rolo-probe-baseline-artifact-index/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Probe baseline artifact index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline_id", "generated_at", "artifacts"],
  "properties": {
    "schema_version": {"const": "rolo-probe-baseline-artifact-index/v1"},
    "baseline_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/Artifact"}},
    "digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "role", "immutable"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"type": "string"},
        "schema_version": {"type": ["string", "null"]},
        "immutable": {"const": true}
      }
    }
  }
}
