{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rolo.dev/schemas/rolo-release-bound-trace-plan-v1.json",
  "title": "Rolo canonical release-bound Trace plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "session_id", "target_id", "catalog_digest", "task", "mode", "max_calls", "operator_id", "safety_confirmed", "scope", "created_at", "expires_at", "release_digest", "compile_context_digest", "target_fingerprint", "evidence_digest", "mapping_confirmation_receipt_digest", "mapping_admission", "mapping_identity_digest", "targetd_authority_head_digest", "targetd_catalog_head_digest", "calls", "plan_digest"],
  "properties": {
    "schema_version": {"const": "rolo-release-bound-trace-plan/v1"},
    "plan_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "target_id": {"$ref": "#/$defs/id"},
    "catalog_digest": {"$ref": "#/$defs/hex"},
    "task": {"type": "string", "minLength": 1, "maxLength": 2000},
    "mode": {"enum": ["OBSERVATION_ONLY", "SUPERVISED_FIELD_DEBUG", "UNATTENDED_REMOTE"]},
    "max_calls": {"type": "integer", "minimum": 1, "maximum": 10000},
    "operator_id": {"type": ["string", "null"], "maxLength": 128},
    "safety_confirmed": {"type": "boolean"},
    "scope": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "release_digest": {"$ref": "#/$defs/digest"},
    "compile_context_digest": {"$ref": "#/$defs/digest"},
    "target_fingerprint": {"$ref": "#/$defs/hex"},
    "evidence_digest": {"$ref": "#/$defs/digest"},
    "mapping_confirmation_receipt_digest": {"$ref": "#/$defs/digest"},
    "mapping_admission": {"$ref": "https://rolo.dev/schemas/rolo-targetd-execution-authority-v1.json#/$defs/mapping_admission"},
    "mapping_identity_digest": {"$ref": "#/$defs/digest"},
    "targetd_authority_head_digest": {"anyOf": [{"$ref": "#/$defs/hex"}, {"type": "null"}]},
    "targetd_catalog_head_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "calls": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/call"}},
    "plan_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "tool_id", "arguments", "arguments_digest", "idempotency_key", "timeout_s", "call_digest"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 10000},
        "tool_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "arguments": {"type": "object"},
        "arguments_digest": {"$ref": "#/$defs/digest"},
        "idempotency_key": {"$ref": "#/$defs/id"},
        "timeout_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
        "call_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
