{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rolo.dev/schemas/rkb-episode-query-page-v1.json",
  "title": "RKB-4 Episode query page",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items", "total", "offset", "limit"],
  "properties": {
    "schema_version": {"const": "rkb-episode-query-page/v1"},
    "items": {"type": "array", "maxItems": 100, "items": {"$ref": "RKBEpisodeMetadata.schema.json"}},
    "total": {"type": "integer", "minimum": 0},
    "offset": {"type": "integer", "minimum": 0},
    "limit": {"type": "integer", "minimum": 1, "maximum": 100},
    "next_offset": {"type": ["integer", "null"], "minimum": 0},
    "limitations": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
  }
}
