{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rolo-acl-decision/v1",
  "title": "Rolo signed ACL decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_id",
    "authorization_id",
    "subject_issuer_id",
    "subject_principal_id",
    "key_id",
    "algorithm",
    "action",
    "resource_digest",
    "scope_digest",
    "request_digest",
    "effect",
    "policy_digest",
    "policy_revision",
    "max_confirmation_ttl_s",
    "issued_at",
    "expires_at",
    "payload_digest",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": "rolo-acl-decision/v1"},
    "authority_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authorization_id": {"$ref": "#/$defs/identifier"},
    "subject_issuer_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "subject_principal_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "key_id": {"$ref": "#/$defs/identifier"},
    "algorithm": {"enum": ["EdDSA", "ES256", "RS256"]},
    "action": {"enum": ["mapping.confirm", "mapping.reject", "mapping.cancel"]},
    "resource_digest": {"$ref": "#/$defs/digest"},
    "scope_digest": {"$ref": "#/$defs/digest"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "effect": {"enum": ["ALLOW", "DENY"]},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "policy_revision": {"type": "integer", "minimum": 1},
    "max_confirmation_ttl_s": {"type": "integer", "minimum": 0, "maximum": 86400},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "payload_digest": {"$ref": "#/$defs/digest"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,2048}$"}
  }
}
