{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rolo-operation-policy-catalog/v1",
  "title": "Rolo trusted operation policy catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "target_id", "target_fingerprint", "policies", "catalog_digest"],
  "properties": {
    "schema_version": {"const": "rolo-operation-policy-catalog/v1"},
    "catalog_id": {"$ref": "#/$defs/identifier"},
    "target_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_fingerprint": {"type": "string", "minLength": 1, "maxLength": 256},
    "policies": {
      "type": "array", "minItems": 1, "maxItems": 512,
      "items": {"$ref": "#/$defs/policy"}
    },
    "catalog_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$"},
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "operation_kind", "provider_id", "access", "risk", "dependencies", "motion_possible"],
      "properties": {
        "operation": {"$ref": "#/$defs/operation"},
        "operation_kind": {"enum": ["OBSERVE", "COMPOSE", "INVOKE", "EXECUTE"]},
        "provider_id": {"$ref": "#/$defs/identifier"},
        "access": {"enum": ["read", "experimental_write"]},
        "risk": {"enum": ["R0", "R1", "R2", "R3"]},
        "dependencies": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/operation"}},
        "motion_possible": {"type": "boolean"}
      }
    }
  }
}
