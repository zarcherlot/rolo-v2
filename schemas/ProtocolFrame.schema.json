{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rolo.dev/schemas/rolo-targetd-frame-v1.json",
  "title": "Rolo targetd protocol frame",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "sequence", "session_id", "payload", "frame_digest"],
  "properties": {
    "schema_version": {"const": "rolo-targetd-frame/v1"},
    "kind": {"enum": ["OPEN_JOURNEY", "BOOTSTRAP", "HANDOFF", "HAS", "PUT", "CALL", "EVENT", "RESULT", "CANCEL", "PHASE_CHANGE", "CLOSE_SESSION", "RESUME_SESSION", "QUERY_CALL"]},
    "sequence": {"type": "integer", "minimum": 0},
    "session_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "payload": {"type": "object"},
    "frame_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
