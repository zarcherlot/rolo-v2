{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rolo.dev/schemas/rolo-targetd-mapping-cancel-v1.json",
  "title": "Rolo targetd Mapping cancellation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_id",
    "authority_head_digest",
    "mapping_confirmation_receipt_digest",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {
      "const": "rolo-targetd-mapping-cancel/v1"
    },
    "tool_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "authority_head_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mapping_confirmation_receipt_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  }
}
