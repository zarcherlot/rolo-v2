{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rolo.local/schemas/ReleaseUploadStatus.schema.json",
  "title": "Release Upload Resume Status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_digest", "blob_digest", "total_bytes", "received_chunks", "missing_chunks", "finalized"],
  "properties": {
    "schema_version": {"const": "rolo-release-upload-status/v1"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "blob_digest": {"$ref": "#/$defs/digest"},
    "total_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
    "received_chunks": {"type": "array", "maxItems": 64, "items": {"type": "integer", "minimum": 0, "maximum": 63}, "uniqueItems": true},
    "missing_chunks": {"type": "array", "maxItems": 64, "items": {"type": "integer", "minimum": 0, "maximum": 63}, "uniqueItems": true},
    "finalized": {"type": "boolean"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
