{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rolo.dev/schemas/rolo-targetd-execution-authority-v1.json",
  "title": "Rolo targetd current execution authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_id", "target_id", "target_fingerprint", "bundle_digest", "binding_digest", "surface_digest", "release_digest", "context_digest", "mapping_confirmation_receipt_digest", "mapping_admission", "catalog_head_digest", "provider_id", "provider_operation", "mode", "fence_epoch", "authority_head_digest"],
  "properties": {
    "schema_version": {"const": "rolo-targetd-execution-authority/v1"},
    "tool_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "target_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "target_fingerprint": {"type": "string", "minLength": 1, "maxLength": 256},
    "bundle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "surface_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "context_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "mapping_confirmation_receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "mapping_admission": {"$ref": "#/$defs/mapping_admission"},
    "catalog_head_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "provider_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "provider_operation": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "mode": {"type": "string", "minLength": 1, "maxLength": 64},
    "fence_epoch": {"type": "integer", "minimum": 1},
    "authority_head_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "mapping_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journey_session_id", "target_id", "target_fingerprint", "target_identity_digest", "candidate_index_digest", "candidate_digest", "proposal_digest", "dsl_digest", "context_digest", "evidence_digest", "available_tool_catalog_digest", "scope", "scope_digest"],
      "properties": {
        "journey_session_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "target_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "target_fingerprint": {"type": "string", "minLength": 1, "maxLength": 256, "not": {"const": "UNKNOWN"}},
        "target_identity_digest": {"$ref": "#/$defs/digest"},
        "candidate_index_digest": {"$ref": "#/$defs/digest"},
        "candidate_digest": {"$ref": "#/$defs/digest"},
        "proposal_digest": {"$ref": "#/$defs/digest"},
        "dsl_digest": {"$ref": "#/$defs/digest"},
        "context_digest": {"$ref": "#/$defs/digest"},
        "evidence_digest": {"$ref": "#/$defs/digest"},
        "available_tool_catalog_digest": {"$ref": "#/$defs/digest"},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool_id", "operation_kind", "operations", "access", "risk"],
          "properties": {
            "tool_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$"},
            "operation_kind": {"enum": ["OBSERVE", "COMPOSE", "INVOKE", "EXECUTE"]},
            "operations": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
            "access": {"enum": ["read", "experimental_write"]},
            "risk": {"enum": ["R0", "R1", "R2", "R3"]}
          }
        },
        "scope_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
