{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rolo.dev/schemas/rolo-mvp/v1/odom-ekf-observation.json",
  "title": "Rolo Odom EKF Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "executor_user", "graph_publisher_count", "graph_subscription_count", "odom_raw_samples", "odom_samples", "imu_samples", "tf_odom_base_available"],
  "properties": {
    "schema_version": {"const": "rolo-odom-ekf-observation/v1"},
    "executor_user": {"type": "string", "minLength": 1},
    "publisher_user": {"type": ["string", "null"]},
    "rmw_implementation": {"type": ["string", "null"]},
    "graph_publisher_count": {"type": "integer", "minimum": 0},
    "graph_subscription_count": {"type": "integer", "minimum": 0},
    "command_publisher_count": {"type": "integer", "minimum": 0},
    "autonomous_source_confirmed": {"type": "boolean"},
    "odom_raw_samples": {"type": "integer", "minimum": 0},
    "odom_samples": {"type": "integer", "minimum": 0},
    "imu_samples": {"type": "integer", "minimum": 0},
    "tf_odom_base_available": {"type": "boolean"},
    "raw_yaw_delta_rad": {"type": ["number", "null"]},
    "ekf_yaw_delta_rad": {"type": ["number", "null"]},
    "odom_pose_source": {"enum": ["COMMAND_INTEGRATION", "MEASURED_FEEDBACK", "UNKNOWN"]},
    "raw_imu_orientation_valid": {"type": ["boolean", "null"]},
    "imu_orientation_covariance_valid": {"type": ["boolean", "null"]},
    "imu_orientation_covariance_status": {"enum": ["VALID", "UNKNOWN_ALL_ZERO", "UNAVAILABLE_SENTINEL", "MALFORMED", "MIXED", null]},
    "imu_use_mag": {"type": ["boolean", "null"]},
    "imu_absolute_yaw_available": {"type": ["boolean", "null"]},
    "imu_yaw_initialization": {"enum": ["UNSET", "RELATIVE", "ABSOLUTE", "UNKNOWN"]},
    "reset_callback_error": {"type": ["string", "null"]},
    "bringup_environment_complete": {"type": ["boolean", "null"]},
    "observed_at": {"type": ["string", "null"]},
    "duration_s": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 300},
    "ros_domain_id": {"type": ["string", "null"]},
    "executor_uid": {"type": ["integer", "null"], "minimum": 0},
    "node_names": {"type": "array", "items": {"type": "string"}, "maxItems": 256},
    "process_presence": {"type": "object", "additionalProperties": {"type": "boolean"}, "maxProperties": 16},
    "service_names": {"type": "array", "items": {"type": "string"}, "maxItems": 256},
    "graph_topics": {"type": "array", "items": {"type": "string"}, "maxItems": 256},
    "graph": {"type": "object", "maxProperties": 64},
    "raw_publisher_nodes": {"type": "array", "items": {"type": "string"}, "maxItems": 64},
    "ekf_publisher_nodes": {"type": "array", "items": {"type": "string"}, "maxItems": 64},
    "command_publisher_nodes": {"type": "array", "items": {"type": "string"}, "maxItems": 64},
    "topic_rates_hz": {"type": "object", "additionalProperties": {"type": ["number", "null"]}, "maxProperties": 32},
    "topic_max_gap_s": {"type": "object", "additionalProperties": {"type": ["number", "null"]}, "maxProperties": 32},
    "topic_header_timestamp_quality": {"type": "object", "additionalProperties": {"type": "string"}, "maxProperties": 32},
    "topic_timestamp_regressions": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}, "maxProperties": 32},
    "command_integrated_yaw_delta_rad": {"type": ["number", "null"]},
    "command_to_raw_yaw_error_rad": {"type": ["number", "null"]},
    "command_nonzero_samples": {"type": ["integer", "null"], "minimum": 0},
    "command_active_span_s": {"type": ["number", "null"], "minimum": 0},
    "raw_yaw_initial_rad": {"type": ["number", "null"]},
    "ekf_yaw_initial_rad": {"type": ["number", "null"]},
    "imu_yaw_initial_rad": {"type": ["number", "null"]},
    "imu_yaw_delta_rad": {"type": ["number", "null"]},
    "imu_quaternion_yaw_initial_rad": {"type": ["number", "null"]},
    "imu_relative_yaw_delta_rad": {"type": ["number", "null"]},
    "imu_gyro_integrated_yaw_delta_rad": {"type": ["number", "null"]},
    "imu_gyro_mean_rad_s": {"type": ["number", "null"]},
    "imu_gyro_streams": {"type": "object", "maxProperties": 8, "additionalProperties": {"type": ["number", "null"]}},
    "imu_yaw_comparison_source": {"enum": ["QUATERNION_RELATIVE", "NONE", null]},
    "independent_motion_evidence": {"type": "object", "maxProperties": 16, "additionalProperties": true},
    "physical_motion_verified": {"type": ["boolean", "null"]},
    "motion_evidence_status": {"enum": ["VERIFIED", "NOT_VERIFIED", "UNKNOWN", null]},
    "motion_evidence_kind": {"type": ["string", "null"]},
    "imu_yaw_rate_residual_rad_s": {"type": ["number", "null"]},
    "imu_yaw_rate_residual_abs_rad_s": {"type": ["number", "null"]},
    "raw_frame_ids": {"type": "array", "items": {"type": "string"}, "maxItems": 16},
    "raw_child_frame_ids": {"type": "array", "items": {"type": "string"}, "maxItems": 16},
    "ekf_frame_ids": {"type": "array", "items": {"type": "string"}, "maxItems": 16},
    "ekf_child_frame_ids": {"type": "array", "items": {"type": "string"}, "maxItems": 16},
    "imu_frame_ids": {"type": "array", "items": {"type": "string"}, "maxItems": 16},
    "frame_consistency": {"type": "object", "maxProperties": 16},
    "imu_valid_samples": {"type": ["integer", "null"], "minimum": 0},
    "imu_invalid_orientation_samples": {"type": ["integer", "null"], "minimum": 0},
    "imu_orientation_valid_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "imu_yaw_fused": {"type": ["boolean", "null"]},
    "yaw_relationship": {"type": ["object", "null"]},
    "imu_raw_yaw_relationship": {"type": ["object", "null"]},
    "tf_pairs": {"type": "array", "items": {"type": "string"}, "maxItems": 256},
    "reset_service_available": {"type": ["boolean", "null"]},
    "reset_topic_available": {"type": ["boolean", "null"]},
    "reset_probe_performed": {"type": "boolean"},
    "reset_survival_verified": {"type": ["boolean", "null"]},
    "launch_environment": {"type": "object", "maxProperties": 32},
    "ekf_parameters": {"type": "object", "maxProperties": 32},
    "measurement_semantics": {"type": "object", "maxProperties": 32},
    "calibration": {"type": "object", "maxProperties": 32},
    "source_inference": {"type": ["string", "null"]},
    "source_inference_confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
    "limitations": {"type": "array", "items": {"type": "string"}, "maxItems": 64}
  }
}
