{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rolo-target-conformance/v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "t1_target_resolve", "t2_bundle_build",
    "t3_runtime_behavior", "t4_release_integrity", "tool_id",
    "operation_kind", "target_id", "target_fingerprint",
    "target_identity_digest", "evidence_digest", "dsl_digest",
    "context_digest", "ir_digest", "bundle_digest",
    "compile_artifact_digest", "compiler_version", "compiler_backend_id",
    "compiler_backend_version", "runtime_backend_id",
    "runtime_binding_digest", "runtime_result_digest",
    "required_capabilities", "required_runtime_capabilities",
    "negotiated_capabilities",
    "journey_session_id", "confirmation_receipt_digest",
    "conformance_idempotency_key", "proofs", "diagnostics"
  ],
  "properties": {
    "schema_version": {"const": "rolo-target-conformance/v3"},
    "t1_target_resolve": {"enum": ["PASS", "FAIL"]},
    "t2_bundle_build": {"enum": ["PASS", "FAIL"]},
    "t3_runtime_behavior": {"enum": ["PASS", "FAIL"]},
    "t4_release_integrity": {"enum": ["PASS", "FAIL"]},
    "tool_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "operation_kind": {"enum": ["OBSERVE", "COMPOSE", "INVOKE", "EXECUTE"]},
    "target_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "target_fingerprint": {"type": "string", "minLength": 1, "maxLength": 512},
    "target_identity_digest": {"$ref": "#/$defs/digest"},
    "evidence_digest": {"$ref": "#/$defs/digest"},
    "dsl_digest": {"$ref": "#/$defs/digest"},
    "context_digest": {"$ref": "#/$defs/digest"},
    "ir_digest": {"$ref": "#/$defs/digest"},
    "bundle_digest": {"$ref": "#/$defs/digest"},
    "compile_artifact_digest": {"$ref": "#/$defs/digest"},
    "compiler_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "compiler_backend_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "compiler_backend_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "runtime_backend_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "runtime_binding_digest": {"$ref": "#/$defs/digest"},
    "runtime_result_digest": {"$ref": "#/$defs/digest"},
    "required_capabilities": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}},
    "required_runtime_capabilities": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}},
    "negotiated_capabilities": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}},
    "journey_session_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "confirmation_receipt_digest": {"$ref": "#/$defs/digest"},
    "conformance_idempotency_key": {"$ref": "#/$defs/digest"},
    "proofs": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/proof"}},
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "status", "evidence_ref", "evidence_digest"],
      "properties": {
        "gate": {"enum": ["T1", "T2", "T3", "T4"]},
        "status": {"enum": ["PASS", "FAIL"]},
        "evidence_ref": {"type": "string", "pattern": "^target-conformance/t[1-4]-[a-z0-9-]+\\.json$"},
        "evidence_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
