{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rolo-mapping-sufficiency/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intent", "context_digest", "status", "candidate_ids", "missing_items", "reasons", "bounded_probe_allowed"],
  "properties": {
    "schema_version": {"const": "rolo-mapping-sufficiency/v1"},
    "intent": {"type": "string", "minLength": 1, "maxLength": 2000},
    "context_digest": {"type": "string", "minLength": 1},
    "status": {"enum": ["READY", "NEEDS_PROBE", "UNSUPPORTED"]},
    "candidate_ids": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
    "missing_items": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
    "reasons": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
    "bounded_probe_allowed": {"type": "boolean"}
  }
}
