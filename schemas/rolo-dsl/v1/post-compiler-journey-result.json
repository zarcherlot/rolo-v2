{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rolo-post-compiler-journey-result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "journey_session_id",
    "target_id",
    "dsl_digest",
    "context_digest",
    "target_compile_status"
  ],
  "properties": {
    "schema_version": {"const": "rolo-post-compiler-journey-result/v1"},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "journey_session_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "dsl_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "context_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "target_compile_status": {"type": "string", "minLength": 1},
    "target_conformance_digest": {"type": ["string", "null"]},
    "release_digest": {"type": ["string", "null"]},
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  }
}
