{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rolo-compile-context/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "robot_id", "target_fingerprint", "evidence_digest"],
  "properties": {
    "schema_version": {"const": "rolo-compile-context/v1"},
    "robot_id": {"type": "string", "minLength": 1},
    "target_fingerprint": {"type": "string", "minLength": 1},
    "runtime_revision": {"type": ["string", "null"]},
    "evidence_digest": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "routes": {"type": "array", "items": {"type": "object"}},
    "message_schemas": {"type": "array", "items": {"type": "object"}},
    "published_tools": {"type": "array", "items": {"type": "object"}},
    "mhs_manifest_refs": {"type": "array", "items": {"type": "string"}},
    "mhs_manifest_digests": {"type": "array", "items": {"type": "string"}},
    "freshness": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
