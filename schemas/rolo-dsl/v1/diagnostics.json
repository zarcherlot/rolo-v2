{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rolo.dev/schemas/rolo-dsl/v1/diagnostics.json",
  "title": "Rolo DSL Diagnostic v1", "type": "object", "additionalProperties": false,
  "required": ["code", "path", "severity", "message"],
  "properties": {
    "code": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1},
    "severity": {"enum": ["ERROR", "WARNING"]}, "message": {"type": "string", "minLength": 1}
  }
}
