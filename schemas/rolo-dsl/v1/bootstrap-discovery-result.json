{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rolo-bootstrap-discovery-result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "discovery_session_id",
    "profile_id",
    "robot_id",
    "target_fingerprint",
    "evidence_digest",
    "limitations",
    "observed_at"
  ],
  "properties": {
    "schema_version": {"const": "rolo-bootstrap-discovery-result/v1"},
    "status": {"enum": ["READY", "BLOCKED"]},
    "discovery_session_id": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "robot_id": {"type": "string", "minLength": 1},
    "target_fingerprint": {"type": "string", "minLength": 1},
    "evidence_digest": {"type": "string", "minLength": 1},
    "compile_context_digest": {"type": ["string", "null"]},
    "candidate_index_digest": {"type": ["string", "null"]},
    "compile_context_ref": {"type": ["string", "null"]},
    "compile_context_index_ref": {"type": ["string", "null"]},
    "candidate_index_ref": {"type": ["string", "null"]},
    "manifest_ref": {"type": ["string", "null"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "observed_at": {"type": "string", "format": "date-time"}
  }
}
