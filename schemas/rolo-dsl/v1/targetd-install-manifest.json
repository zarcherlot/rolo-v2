{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rolo-targetd-install-manifest/v1",
  "title": "Rolo targetd install manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_version", "archive_sha256", "files"],
  "properties": {
    "schema_version": {"const": "rolo-targetd-install-manifest/v1"},
    "package_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "string", "minLength": 1}}
  }
}
