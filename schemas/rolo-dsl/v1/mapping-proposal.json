{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rolo-mapping-proposal/v1",
  "title": "Rolo mapping proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "journey_session_id", "user_goal", "candidate_id", "operation", "context_digest", "evidence_digest", "evidence_refs", "risks", "unknowns", "requested_actions", "status"],
  "properties": {
    "schema_version": {"const": "rolo-mapping-proposal/v1"},
    "journey_session_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "user_goal": {"type": "string", "minLength": 1, "maxLength": 2000},
    "candidate_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "operation": {"type": "string", "minLength": 1, "maxLength": 256},
    "context_digest": {"type": "string", "minLength": 1},
    "evidence_digest": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string"}},
    "dsl_digest": {"type": ["string", "null"], "maxLength": 128},
    "risks": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
    "unknowns": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
    "requested_actions": {"type": "array", "maxItems": 16, "items": {"type": "string"}},
    "status": {"enum": ["PROPOSED", "CONFIRMED", "REJECTED", "BLOCKED"]}
  }
}
