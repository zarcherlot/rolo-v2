{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rolo-mapping-proposal/v2",
  "title": "Rolo mapping proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "journey_session_id",
    "user_goal",
    "target_id",
    "target_fingerprint",
    "candidate_index_digest",
    "candidate_digest",
    "candidate_id",
    "operation",
    "dsl_digest",
    "context_digest",
    "evidence_digest",
    "available_tool_catalog_digest",
    "scope",
    "evidence_refs",
    "risks",
    "unknowns",
    "requested_actions",
    "status",
    "proposal_digest"
  ],
  "properties": {
    "schema_version": {"const": "rolo-mapping-proposal/v2"},
    "journey_session_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "user_goal": {"type": "string", "minLength": 1, "maxLength": 2000},
    "target_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_fingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "not": {"enum": ["UNKNOWN", "unknown"]}
    },
    "candidate_index_digest": {"$ref": "#/$defs/digest"},
    "candidate_digest": {"$ref": "#/$defs/digest"},
    "candidate_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "operation": {"type": "string", "minLength": 1, "maxLength": 256},
    "dsl_digest": {"$ref": "#/$defs/digest"},
    "context_digest": {"$ref": "#/$defs/digest"},
    "evidence_digest": {"$ref": "#/$defs/digest"},
    "available_tool_catalog_digest": {"$ref": "#/$defs/digest"},
    "scope": {"$ref": "#/$defs/scope"},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "risks": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "unknowns": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "requested_actions": {
      "type": "array",
      "prefixItems": [{"const": "user_confirmation"}],
      "minItems": 1,
      "maxItems": 1
    },
    "status": {"const": "PROPOSED"},
    "proposal_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_id", "operation_kind", "operations", "access", "risk"],
      "properties": {
        "tool_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
        },
        "operation_kind": {
          "enum": ["OBSERVE", "COMPOSE", "INVOKE", "EXECUTE"]
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "access": {"enum": ["read", "experimental_write"]},
        "risk": {"enum": ["R0", "R1", "R2", "R3"]}
      }
    }
  }
}
