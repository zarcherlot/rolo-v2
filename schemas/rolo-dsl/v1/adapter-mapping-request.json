{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rolo-adapter-mapping-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "journey_session_id", "user_goal", "context_digest", "available_tool_catalog_digest", "operation_candidates", "dsl_version"],
  "properties": {
    "schema_version": {"const": "rolo-adapter-mapping-request/v1"},
    "journey_session_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "user_goal": {"type": "string", "minLength": 1, "maxLength": 2000},
    "context_digest": {"type": "string", "minLength": 1},
    "available_tool_catalog_digest": {"type": "string", "minLength": 1},
    "operation_candidates": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
    "dsl_version": {"const": "rolo-dsl/v1"}
  }
}
