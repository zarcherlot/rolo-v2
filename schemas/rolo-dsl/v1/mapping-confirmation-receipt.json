{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rolo-mapping-confirmation-receipt/v1",
  "title": "Rolo Mapping confirmation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "journey_session_id",
    "target_id",
    "target_fingerprint",
    "target_identity_digest",
    "candidate_index_digest",
    "candidate_digest",
    "proposal_digest",
    "dsl_digest",
    "context_digest",
    "evidence_digest",
    "available_tool_catalog_digest",
    "scope",
    "scope_digest",
    "schema_version",
    "sequence",
    "decision_id",
    "actor_id",
    "decision",
    "decided_at",
    "expires_at",
    "supersedes_receipt_digest",
    "previous_receipt_digest",
    "receipt_digest"
  ],
  "properties": {
    "journey_session_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "target_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "target_fingerprint": {"type": "string", "minLength": 1, "maxLength": 256, "not": {"const": "UNKNOWN"}},
    "target_identity_digest": {"$ref": "#/$defs/digest"},
    "candidate_index_digest": {"$ref": "#/$defs/digest"},
    "candidate_digest": {"$ref": "#/$defs/digest"},
    "proposal_digest": {"$ref": "#/$defs/digest"},
    "dsl_digest": {"$ref": "#/$defs/digest"},
    "context_digest": {"$ref": "#/$defs/digest"},
    "evidence_digest": {"$ref": "#/$defs/digest"},
    "available_tool_catalog_digest": {"$ref": "#/$defs/digest"},
    "scope": {"$ref": "#/$defs/scope"},
    "scope_digest": {"$ref": "#/$defs/digest"},
    "schema_version": {"const": "rolo-mapping-confirmation-receipt/v1"},
    "sequence": {"type": "integer", "minimum": 1},
    "decision_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "actor_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "decision": {"enum": ["CONFIRMED", "REJECTED", "CANCELLED"]},
    "decided_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "supersedes_receipt_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "previous_receipt_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_id", "operation_kind", "operations", "access", "risk"],
      "properties": {
        "tool_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$"},
        "operation_kind": {"enum": ["OBSERVE", "COMPOSE", "INVOKE", "EXECUTE"]},
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "access": {"enum": ["read", "experimental_write"]},
        "risk": {"enum": ["R0", "R1", "R2", "R3"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "CONFIRMED"}}},
      "then": {
        "properties": {
          "expires_at": {"type": "string", "format": "date-time"},
          "supersedes_receipt_digest": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "CANCELLED"}}},
      "then": {
        "properties": {
          "expires_at": {"type": "null"},
          "supersedes_receipt_digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "REJECTED"}}},
      "then": {
        "properties": {
          "expires_at": {"type": "null"},
          "supersedes_receipt_digest": {"type": "null"}
        }
      }
    }
  ]
}
