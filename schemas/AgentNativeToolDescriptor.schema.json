{
  "$defs": {
    "NativeToolInvocation": {
      "additionalProperties": false,
      "description": "One static argv shape in a family-level descriptor.",
      "properties": {
        "executable": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Executable",
          "type": "string"
        },
        "argv_template": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Argv Template",
          "type": "array"
        },
        "required_parameters": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Required Parameters",
          "type": "array"
        },
        "unavailable_return_codes": {
          "items": {
            "type": "integer"
          },
          "maxItems": 8,
          "title": "Unavailable Return Codes",
          "type": "array"
        },
        "environment_dependency": {
          "default": "NONE",
          "enum": [
            "NONE",
            "NETWORK"
          ],
          "title": "Environment Dependency",
          "type": "string"
        }
      },
      "required": [
        "executable",
        "argv_template"
      ],
      "title": "NativeToolInvocation",
      "type": "object"
    },
    "NativeToolParameter": {
      "additionalProperties": false,
      "description": "A bounded argument accepted by a family-level native tool.",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "default": "token",
          "enum": [
            "token",
            "enum",
            "integer",
            "path"
          ],
          "title": "Kind",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "choices": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Choices",
          "type": "array"
        },
        "pattern": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "max_length": {
          "default": 128,
          "maximum": 1024,
          "minimum": 1,
          "title": "Max Length",
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "title": "NativeToolParameter",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Allowlisted command metadata; this is not a Canonical Operation contract.",
  "properties": {
    "schema_version": {
      "default": "rolo-agent-native-tool/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "tool_id": {
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Tool Id",
      "type": "string"
    },
    "family": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Family",
      "type": "string"
    },
    "execution_path": {
      "pattern": "^(DIRECT_RUNNER|ROS_CLI)$",
      "title": "Execution Path",
      "type": "string"
    },
    "executable": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Executable",
      "type": "string"
    },
    "argv_template": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Argv Template",
      "type": "array"
    },
    "access": {
      "pattern": "^(read|experimental_write)$",
      "title": "Access",
      "type": "string"
    },
    "risk": {
      "pattern": "^(R0|R1|R2|R3)$",
      "title": "Risk",
      "type": "string"
    },
    "max_duration_s": {
      "exclusiveMinimum": 0,
      "maximum": 120,
      "title": "Max Duration S",
      "type": "number"
    },
    "max_output_bytes": {
      "exclusiveMinimum": 0,
      "maximum": 1000000,
      "title": "Max Output Bytes",
      "type": "integer"
    },
    "evidence_kind": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Evidence Kind",
      "type": "string"
    },
    "sensitive": {
      "default": false,
      "title": "Sensitive",
      "type": "boolean"
    },
    "allowed_env_keys": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Allowed Env Keys",
      "type": "array"
    },
    "parameters": {
      "items": {
        "$ref": "#/$defs/NativeToolParameter"
      },
      "maxItems": 32,
      "title": "Parameters",
      "type": "array"
    },
    "variants": {
      "additionalProperties": {
        "$ref": "#/$defs/NativeToolInvocation"
      },
      "maxProperties": 32,
      "title": "Variants",
      "type": "object"
    }
  },
  "required": [
    "tool_id",
    "family",
    "execution_path",
    "executable",
    "argv_template",
    "access",
    "risk",
    "max_duration_s",
    "max_output_bytes",
    "evidence_kind"
  ],
  "title": "AgentNativeToolDescriptor",
  "type": "object"
}
