{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rolo-mvp-certification-suite/v1",
  "type": "object",
  "required": ["schema_version", "suite_id", "target_id", "cases"],
  "properties": {
    "schema_version": {"const": "rolo-mvp-certification-suite/v1"},
    "suite_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["case_id", "description", "tool_id"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
          "description": {"type": "string", "minLength": 1, "maxLength": 500},
          "tool_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "arguments": {"type": "object"},
          "expected": {},
          "timeout_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
          "risk": {"enum": ["R0", "R1", "R2"]},
          "stop_condition": {"type": "string", "maxLength": 256}
        },
        "additionalProperties": false
      }
    },
    "digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
