{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rolo-mvp-certification-report/v1",
  "type": "object",
  "required": ["run_id", "target_id", "snapshot_digest", "suite_digest", "results", "conclusion"],
  "properties": {
    "run_id": {"type": "string"},
    "target_id": {"type": "string"},
    "snapshot_digest": {"type": "string"},
    "suite_digest": {"type": "string"},
    "results": {"type": "array"},
    "conclusion": {"enum": ["PASS", "CONDITIONAL", "BLOCKED"]},
    "compile_context_digest": {"type": ["string", "null"]},
    "target_fingerprint": {"type": ["string", "null"]},
    "failure_policy": {"enum": ["continue", "fail_fast"]},
    "event_count": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
