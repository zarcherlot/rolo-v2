{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rolo.dev/schemas/rolo-targetd-call-receipt-v2.json",
  "title": "Rolo fenced targetd call receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "idempotency_key", "session_id", "target_id", "bundle_digest", "request_digest", "release_digest", "context_digest", "mapping_confirmation_receipt_digest", "authority_head_digest", "fence_epoch", "provider_id", "provider_operation", "provider_fence_digest", "status", "updated_at"],
  "properties": {
    "schema_version": {"const": "rolo-targetd-call-receipt/v2"},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "session_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "target_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "bundle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "context_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "mapping_confirmation_receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authority_head_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fence_epoch": {"type": "integer", "minimum": 1},
    "provider_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "provider_operation": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "provider_fence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["ACCEPTED", "STARTED", "SUCCEEDED", "FAILED", "STOPPED", "CANCELLED", "UNKNOWN", "NOT_ACCEPTED"]},
    "result": {"type": ["object", "null"]},
    "evidence_refs": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
    "artifact_refs": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
    "provider_started_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
