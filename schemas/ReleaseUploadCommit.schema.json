{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rolo.local/schemas/ReleaseUploadCommit.schema.json",
  "title": "Atomic Release Upload Commit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_digest", "blob_digest", "total_bytes", "chunk_count"],
  "properties": {
    "schema_version": {"const": "rolo-release-upload-commit/v1"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "blob_digest": {"$ref": "#/$defs/digest"},
    "total_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
    "chunk_count": {"type": "integer", "minimum": 1, "maximum": 64}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
